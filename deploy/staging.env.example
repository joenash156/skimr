# Template for the SERVER's .env (InfinityFree: htdocs/.env). deploy/README.md, step 2.
#
# How to use it:
#   1. InfinityFree panel > File Manager > htdocs/ > New File ".env".
#   2. Paste this template into the editor there and fill in the <...> values in place.
#      Don't save a filled-in copy on your laptop, in the repo or in a chat.
#   3. Keep the real values in a password manager (e.g. Bitwarden) as the only other copy.
#   4. Check https://skimr.foliony.app/.env answers 403 or 404.
#
# Every value here is a STAGING/PRODUCTION value: never reuse a local one.

APP_ENV=staging
APP_DEBUG=false
APP_URL=https://skimr.foliony.app
APP_NAME="Skimr"

# InfinityFree panel > MySQL Databases. The password is the hosting account's
# password (panel > Account > "Show/Hide" next to the password), not your login password.
DB_HOST=<sqlNNN.infinityfree.com>
DB_PORT=3306
DB_NAME=<if0_XXXXXXXX_skimr>
DB_USER=<if0_XXXXXXXX>
DB_PASS=<hosting account password>

# NEW secrets, generated just for the server (run twice, use each output once):
#   php -r "echo bin2hex(random_bytes(64)), PHP_EOL;"
# Changing them later signs everyone out.
JWT_ACCESS_SECRET=<128 hex characters>
JWT_REFRESH_SECRET=<128 different hex characters>

# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application).
# Authorised redirect URI must be exactly the value below. Leave the three empty until set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://skimr.foliony.app/api/v1/auth/google/callback

# Cloudflare dashboard > Turnstile > Add widget, hostname skimr.foliony.app, mode "Managed".
# The site key is public; the secret key is not.
TURNSTILE_SITE_KEY=<0x4AAAA...>
TURNSTILE_SECRET_KEY=<0x4AAAA...>

# Resend > API Keys > "Sending access", restricted to the mail.foliony.app domain.
# Only after the domain shows "Verified". Until P2's MailService is merged, emails are
# written to htdocs/var/mail.log instead (download it via the file manager; never web-reachable).
RESEND_API_KEY=
MAIL_FROM="Skimr <no-reply@mail.foliony.app>"
MAIL_REPLY_TO=<team inbox>

# Cloudinary dashboard > API Keys > "API environment variable".
CLOUDINARY_URL=<cloudinary://key:secret@cloud_name>
CLOUDINARY_FOLDER=skimr-prod

# Render URL of P3's service once it's live. The secret must be the SAME value in
# Render's environment for the ai-service (generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;").
AI_SERVICE_URL=<https://skimr-ai.onrender.com>
AI_SERVICE_SECRET=<64 hex characters>

LOG_LEVEL=info

# Only while running migrations (deploy/README.md), then delete the line.
# MIGRATION_TOKEN=

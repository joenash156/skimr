{#
 # variant 'compact': EN / FR / ES segmented control (header, desktop).
 # variant 'full': full language names (mobile menu, footer).
 # Links go to the same page in the other language (metadata.alternates).
 #}
{% set variant = variant|default('full') %}
{% set languages = [] %}
{% if metadata is defined %}
    {% for alternate in metadata.alternates|filter(a => a.locale != 'x-default') %}
        {% set languages = languages|merge([{code: alternate.locale, url: alternate.url}]) %}
    {% endfor %}
{% else %}
    {% set languages = [{code: 'en', url: '/en/'}, {code: 'fr', url: '/fr/'}, {code: 'es', url: '/es/'}] %}
{% endif %}
<div class="lang-switch lang-switch--{{ variant }}{{ variant == 'compact' ? ' hide-mobile' : '' }}" role="group" aria-label="{{ trans('public.language') }}">
    {% for language in languages %}
        <a class="lang-switch__item" href="{{ language.url }}" lang="{{ language.code }}" hreflang="{{ language.code }}"
           {% if locale == language.code %}aria-current="page"{% endif %}
           {% if variant == 'compact' %}title="{{ trans('public.language_names.' ~ language.code) }}" aria-label="{{ trans('public.language_names.' ~ language.code) }}"{% endif %}>
            {{- variant == 'compact' ? language.code|upper : trans('public.language_names.' ~ language.code) -}}
        </a>
    {% endfor %}
</div>

{% extends 'base.html.twig' %}

{% block title %}{{ trans('public.pages.' ~ page_key ~ '.title') }}{% endblock %}
{% block description %}{{ trans('public.pages.' ~ page_key ~ '.description') }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ site_url }}{{ canonical_path }}">{% endblock %}
{% block alternates %}
    <link rel="alternate" hreflang="en" href="{{ site_url }}{{ canonical_path }}">
    <link rel="alternate" hreflang="x-default" href="{{ site_url }}{{ canonical_path }}">
{% endblock %}
{% block og %}
    <meta property="og:title" content="{{ trans('public.pages.' ~ page_key ~ '.title') }}">
    <meta property="og:description" content="{{ trans('public.pages.' ~ page_key ~ '.description') }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site_url }}{{ canonical_path }}">
    <meta property="og:image" content="{{ site_url }}/assets/og-default.svg">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block content %}
    {% include 'pages/' ~ page_key ~ '.html.twig' %}
{% endblock %}

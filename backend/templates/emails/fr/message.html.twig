{% extends "fr/layout.html.twig" %}

{% block content %}
    {% if template == 'verify_email' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Confirmez votre adresse e-mail</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Confirmez votre adresse e-mail pour activer votre compte Skimr. Ce lien expire dans {{ expires_hours }} heures.</p>
        <p><a href="{{ link }}" style="display:inline-block;padding:12px 24px;background-color:#0a0a0a;color:#ffffff;font-weight:600;text-decoration:none;border-radius:999px;">Confirmer mon e-mail</a></p>
    {% elseif template == 'reset_password' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Réinitialisez votre mot de passe</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Nous avons reçu une demande de réinitialisation de votre mot de passe Skimr. Ce lien expire dans {{ expires_minutes }} minutes.</p>
        <p><a href="{{ link }}" style="display:inline-block;padding:12px 24px;background-color:#0a0a0a;color:#ffffff;font-weight:600;text-decoration:none;border-radius:999px;">Réinitialiser mon mot de passe</a></p>
        <p>Si vous n’êtes pas à l’origine de cette demande, ignorez ce message.</p>
    {% elseif template == 'new_sign_in' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Nouvelle connexion à votre compte</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Un nouvel appareil s’est connecté à votre compte Skimr le {{ at|date('Y-m-d H:i', 'UTC') }} UTC.</p>
        <p>Adresse IP : {{ ip }}<br>Appareil : {{ user_agent }}</p>
        <p>Si vous n’êtes pas à l’origine de cette connexion, réinitialisez votre mot de passe et vérifiez la sécurité de votre compte.</p>
    {% elseif template == 'password_changed' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Votre mot de passe a été modifié</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Votre mot de passe Skimr a été modifié le {{ at|date('Y-m-d H:i', 'UTC') }} UTC. Si vous n’êtes pas à l’origine de cette modification, sécurisez immédiatement votre compte.</p>
    {% elseif template == 'suspicious_activity' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Alerte de sécurité</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Nous avons détecté une activité inhabituelle sur votre compte Skimr le {{ at|date('Y-m-d H:i', 'UTC') }} UTC et avons fermé toutes vos sessions. Connectez-vous et vérifiez la sécurité de votre compte.</p>
    {% elseif template == 'email_change_requested' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Demande de changement d’adresse e-mail</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Une demande effectuée le {{ at|date('Y-m-d H:i', 'UTC') }} UTC vise à remplacer l’adresse e-mail de votre compte Skimr par {{ new_email }}. Le changement ne sera appliqué qu’après confirmation de cette adresse.</p>
        <p>Si vous n’êtes pas à l’origine de cette demande, sécurisez immédiatement votre compte.</p>
    {% elseif template == 'email_changed' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Votre adresse e-mail a été modifiée</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>L’adresse e-mail de votre compte Skimr a été remplacée par {{ new_email }} le {{ at|date('Y-m-d H:i', 'UTC') }} UTC. Si vous n’êtes pas à l’origine de ce changement, sécurisez immédiatement votre compte.</p>
    {% elseif template == 'admin_invite' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Vous avez été invité à administrer Skimr</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Vous avez été invité à rejoindre Skimr comme administrateur. Cette invitation expire dans {{ expires_hours }} heures.</p>
        <p><a href="{{ link }}" style="display:inline-block;padding:12px 24px;background-color:#0a0a0a;color:#ffffff;font-weight:600;text-decoration:none;border-radius:999px;">Accepter l’invitation</a></p>
    {% elseif template == 'account_suspended' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Votre compte a été suspendu</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Votre compte Skimr a été suspendu le {{ at|date('Y-m-d H:i', 'UTC') }} UTC. Motif : {{ reason }}</p>
    {% elseif template == 'account_reactivated' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Votre compte a été réactivé</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Votre compte Skimr a été réactivé le {{ at|date('Y-m-d H:i', 'UTC') }} UTC. Vous pouvez à nouveau vous connecter.</p>
    {% elseif template == 'contact_message' %}
        <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:650;letter-spacing:-0.02em;">Nouveau message de contact</h1>
        <p><strong>De :</strong> {{ name }} ({{ email }})<br><strong>Reçu le :</strong> {{ at|date('Y-m-d H:i', 'UTC') }} UTC</p>
        <p>{{ message|e|nl2br }}</p>
    {% endif %}
{% endblock %}


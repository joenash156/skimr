<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="LOG_LEVEL" value="emergency" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <!-- Tests get their own database (created and migrated by tests/bootstrap.php),
             so they never touch your dev data. Host, user and password still come from .env. -->
        <env name="DB_NAME" value="skimr_test" force="true"/>
        <!-- Test-only values; never use these anywhere else. -->
        <env name="JWT_ACCESS_SECRET" value="test-access-secret-0123456789abcdef0123456789abcdef" force="true"/>
        <env name="JWT_REFRESH_SECRET" value="test-refresh-secret-0123456789abcdef0123456789abcdef" force="true"/>
        <env name="TURNSTILE_SECRET_KEY" value="1x0000000000000000000000000000000AA" force="true"/>
    </php>
</phpunit>

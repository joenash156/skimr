{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as ui %}

{% block content %}
    {#
     # Hero: a full-bleed photo carousel on the left (admin-managed, see App\Public\Hero\HeroSlides)
     # that fades into the page on the right, so it never runs under the demo window.
     # The first slide's heading is the page <h1>; the others are paragraphs styled the same.
     #}
    {% set slide_ms = 6500 %}
    <section class="hero" aria-labelledby="home-title" x-data="heroCarousel" data-interval="{{ slide_ms }}"
             x-on:focusin="hold" x-on:focusout="release"
             style="--slide-ms: {{ slide_ms }}ms">
        <div class="hero__media" aria-hidden="true">
            {% for slide in slides %}
                <img class="hero__image{{ loop.first ? ' is-active' : '' }}" src="{{ slide.imageUrl }}" alt=""
                     width="1600" height="1000" decoding="async"
                     {{ loop.first ? 'fetchpriority=high' : 'loading=lazy' }} data-slide-image>
            {% endfor %}
            <div class="hero__scrim"></div>
        </div>
        <div class="hero__glow" aria-hidden="true"></div>

        <div class="wrap hero__inner">
            <div class="hero__copy">
                <div class="hero__headings" role="group" aria-roledescription="carousel"
                     aria-label="{{ trans('public.home.carousel.label') }}">
                    {% for slide in slides %}
                        {% if loop.first %}
                            <h1 id="home-title" class="hero__title is-active" data-slide-heading>{{ slide.heading }}</h1>
                        {% else %}
                            <p class="hero__title" data-slide-heading aria-hidden="true">{{ slide.heading }}</p>
                        {% endif %}
                    {% endfor %}
                </div>
                <p class="hero__lead">{{ trans('public.home.intro') }}</p>
                <div class="actions">
                    <a class="btn btn--primary btn--lg btn--pill anim-host" href="/app/register">
                        {{ trans('public.home.primary_cta') }} {{ ui.icon('arrow-right', 'icon btn__arrow') }}
                    </a>
                    <a class="btn btn--secondary btn--lg btn--pill" href="{{ page_urls.how_it_works }}">
                        {{ trans('public.home.secondary_cta') }}
                    </a>
                </div>

                {% if slides|length > 1 %}
                    <div class="hero__controls">
                        <button class="hero__pause" type="button" x-on:click="togglePause"
                                aria-label="{{ trans('public.home.carousel.pause') }}"
                                data-label-pause="{{ trans('public.home.carousel.pause') }}"
                                data-label-play="{{ trans('public.home.carousel.play') }}">
                            <span class="hero__pause-icon" aria-hidden="true"></span>
                        </button>
                        <div class="hero__dots">
                            {% for slide in slides %}
                                <button class="hero__dot{{ loop.first ? ' is-active' : '' }}" type="button"
                                        data-index="{{ loop.index0 }}" x-on:click="go"
                                        aria-label="{{ trans('public.home.carousel.slide', {number: loop.index, total: slides|length}) }}"
                                        {{ loop.first ? 'aria-current=true' : '' }}>
                                    <span class="hero__dot-fill"></span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {# An illustration of the evidence rule (spec 2), built from text so it translates. #}
            <figure class="demo" aria-labelledby="demo-caption">
                <figcaption class="demo__bar">
                    <span class="demo__dots" aria-hidden="true"><i class="demo__dot--close"></i><i class="demo__dot--min"></i><i class="demo__dot--max"></i></span>
                    <span id="demo-caption">{{ trans('public.home.demo.caption') }}</span>
                </figcaption>
                <div class="demo__body">
                    <p class="demo__theme">{{ ui.icon('layers') }} {{ trans('public.home.demo.theme') }}</p>
                    {% for finding in ['finding_1', 'finding_2'] %}
                        <div class="finding">
                            <p class="finding__label">{{ ui.icon('quote') }} {{ trans('public.home.evidence.finding.title') }}</p>
                            <blockquote class="finding__quote">{{ trans('public.home.demo.' ~ finding ~ '.quote') }}</blockquote>
                            <span class="source-chip">{{ ui.icon('file') }} {{ trans('public.home.demo.' ~ finding ~ '.source') }}</span>
                        </div>
                    {% endfor %}
                    <div class="interpretation">
                        <p class="interpretation__label">{{ ui.icon('sparkle') }} {{ trans('public.home.evidence.interpretation.title') }}</p>
                        <p>{{ trans('public.home.demo.interpretation.text') }}</p>
                        <p class="interpretation__support">{{ ui.icon('check') }} {{ trans('public.home.demo.interpretation.support') }}</p>
                    </div>
                </div>
            </figure>
        </div>
    </section>

    <section class="section" aria-labelledby="home-how-title">
        <div class="wrap">
            <div class="section__head">
                <p class="kicker">{{ trans('public.home.kickers.how') }}</p>
                <h2 id="home-how-title" class="section__title">{{ trans('public.home.how_it_works.heading') }}</h2>
            </div>
            <ol class="steps">
                {% for step in 1..3 %}
                    <li class="step">
                        <span class="step__number" aria-hidden="true">{{ '%02d'|format(step) }}</span>
                        <h3 class="step__title">{{ trans('public.home.how_it_works.steps.' ~ step ~ '.title') }}</h3>
                        <p>{{ trans('public.home.how_it_works.steps.' ~ step ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    <section class="section section--surface" aria-labelledby="home-sources-title">
        <div class="wrap">
            <div class="section__head">
                <p class="kicker">{{ trans('public.home.kickers.sources') }}</p>
                <h2 id="home-sources-title" class="section__title">{{ trans('public.home.sources.heading') }}</h2>
                <p class="section__intro">{{ trans('public.home.sources.intro') }}</p>
            </div>
            {% set source_icons = {pdf: 'file', images: 'image', links: 'link', text: 'clipboard', discovery: 'search'} %}
            <ul class="grid grid--5">
                {% for source, icon in source_icons %}
                    <li class="card card--hover anim-host">
                        <span class="card__icon">{{ ui.icon(icon, 'icon icon--draw') }}</span>
                        <h3 class="card__title">{{ trans('public.home.sources.items.' ~ source ~ '.title') }}</h3>
                        <p>{{ trans('public.home.sources.items.' ~ source ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section class="section" aria-labelledby="home-features-title">
        <div class="wrap">
            <div class="section__head section__head--row">
                <div>
                    <p class="kicker">{{ trans('public.home.kickers.features') }}</p>
                    <h2 id="home-features-title" class="section__title">{{ trans('public.home.highlights.heading') }}</h2>
                </div>
                <a class="text-link anim-host" href="{{ page_urls.features }}">
                    {{ trans('public.home.highlights.link') }} {{ ui.icon('arrow-up-right', 'icon btn__arrow') }}
                </a>
            </div>
            {% set feature_icons = {search: 'search', themes: 'layers', methods: 'columns', synthesis: 'pen', citations: 'network', gaps: 'compass'} %}
            <ul class="ruled-grid">
                {% for feature, icon in feature_icons %}
                    <li class="ruled-grid__cell anim-host">
                        <span class="ruled-grid__icon">{{ ui.icon(icon, 'icon icon--draw') }}</span>
                        <h3 class="card__title">{{ trans('public.home.highlights.items.' ~ feature ~ '.title') }}</h3>
                        <p>{{ trans('public.home.highlights.items.' ~ feature ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section class="section section--surface" aria-labelledby="home-evidence-title">
        <div class="wrap">
            <div class="section__head">
                <p class="kicker">{{ trans('public.home.kickers.evidence') }}</p>
                <h2 id="home-evidence-title" class="section__title">{{ trans('public.home.evidence.heading') }}</h2>
                <p class="section__intro">{{ trans('public.home.evidence.intro') }}</p>
            </div>
            <div class="grid grid--2">
                <article class="finding finding--card">
                    <p class="finding__label">{{ ui.icon('quote') }} {{ trans('public.home.evidence.finding.title') }}</p>
                    <p>{{ trans('public.home.evidence.finding.description') }}</p>
                </article>
                <article class="interpretation interpretation--card">
                    <p class="interpretation__label">{{ ui.icon('sparkle') }} {{ trans('public.home.evidence.interpretation.title') }}</p>
                    <p>{{ trans('public.home.evidence.interpretation.description') }}</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="home-faq-title">
        <div class="wrap faq-layout">
            <div class="section__head">
                <p class="kicker">{{ trans('public.home.kickers.faq') }}</p>
                <h2 id="home-faq-title" class="section__title">{{ trans('public.home.faq.heading') }}</h2>
            </div>
            <div class="faq">
                {% for question in ['evidence', 'sources', 'privacy', 'languages'] %}
                    <details class="faq__item">
                        <summary>
                            {{ trans('public.home.faq.items.' ~ question ~ '.question') }}
                            <span class="faq__toggle" aria-hidden="true"></span>
                        </summary>
                        <p>{{ trans('public.home.faq.items.' ~ question ~ '.answer') }}</p>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section section--tight" aria-labelledby="home-cta-title">
        <div class="wrap">
            <div class="cta">
                <div>
                    <h2 id="home-cta-title" class="cta__title">{{ trans('public.home.cta.heading') }}</h2>
                    <p>{{ trans('public.home.cta.description') }}</p>
                </div>
                <a class="btn btn--light btn--lg anim-host" href="/app/register">
                    {{ trans('public.home.primary_cta') }} {{ ui.icon('arrow-right', 'icon btn__arrow') }}
                </a>
            </div>
        </div>
    </section>
{% endblock %}

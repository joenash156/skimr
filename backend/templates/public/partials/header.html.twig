<header x-data="mobileMenu" x-on:keydown.escape.window="close">
    <a class="site-logo" href="/{{ locale }}/" aria-label="{{ trans('public.home_link') }}">Skimr</a>
    <nav aria-label="{{ trans('public.main_navigation') }}">
        <a href="/{{ locale }}/#main">{{ trans('public.navigation.home') }}</a>
        {% if locale == 'en' %}
            <a href="/en/features">{{ trans('public.navigation.features') }}</a>
            <a href="/en/how-it-works">{{ trans('public.navigation.how_it_works') }}</a>
            <a href="/en/about">{{ trans('public.navigation.about') }}</a>
        {% endif %}
        <div class="language-switcher" aria-label="{{ trans('public.language') }}">
            <a href="/en/" lang="en" hreflang="en">English</a>
            <a href="/fr/" lang="fr" hreflang="fr">Français</a>
            <a href="/es/" lang="es" hreflang="es">Español</a>
        </div>
        <div class="theme-toggle"
             x-data="themeToggle">
            <button type="button" x-on:click="toggle"
                    aria-label="{{ trans('public.theme.toggle') }}">
                {{ trans('public.theme.toggle') }}
            </button>
        </div>
        <a href="/app/login">{{ trans('public.login') }}</a>
        <a href="/app/register">{{ trans('public.signup') }}</a>
    </nav>
    <button class="mobile-menu-toggle" type="button" x-on:click="toggle"
            x-bind:aria-expanded="open" aria-controls="mobile-menu"
            aria-label="{{ trans('public.menu') }}">
        {{ trans('public.menu') }}
    </button>
    {% include 'partials/mobile-menu.html.twig' %}
</header>

{% set profile = site.forLocale(locale) %}
<footer class="site-footer">
    <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
            {% include 'partials/brand.html.twig' with {uid: 'f'} %}
            <p class="site-footer__tagline">{{ trans('public.home.description') }}</p>
            {% include 'partials/socials.html.twig' %}
        </div>
        {% if page_urls is defined %}
            <nav class="site-footer__nav" aria-label="{{ trans('public.footer_navigation') }}">
                <div>
                    <p class="site-footer__heading">{{ trans('public.footer.product') }}</p>
                    <ul>
                        {% for page in ['features', 'how_it_works', 'about', 'contact'] %}
                            <li><a href="{{ page_urls[page] }}">{{ trans('public.navigation.' ~ page) }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
                <div>
                    <p class="site-footer__heading">{{ trans('public.footer.legal') }}</p>
                    <ul>
                        {% for page in ['privacy', 'terms', 'cookies'] %}
                            <li><a href="{{ page_urls[page] }}">{{ trans('public.navigation.' ~ page) }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
                {% if profile.hasContact() %}
                    <div>
                        <p class="site-footer__heading">{{ trans('public.footer.contact') }}</p>
                        {% include 'partials/contact-details.html.twig' %}
                    </div>
                {% endif %}
            </nav>
        {% endif %}
    </div>
    <div class="wrap site-footer__bottom">
        <p>{{ trans('public.footer.copyright', {year: 'now'|date('Y')}) }}</p>
        <div class="site-footer__settings">
            {% include 'partials/languages.html.twig' with {variant: 'list', uid: 'f'} %}
            {% include 'partials/theme-switch.html.twig' with {variant: 'compact', uid: 'f'} %}
        </div>
    </div>
</footer>

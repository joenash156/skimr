<section class="contact-page" aria-labelledby="contact-title">
    <h1 id="contact-title">{{ trans('public.pages.contact.heading') }}</h1>
    <p>{{ trans('public.pages.contact.intro') }}</p>
    <p id="contact-form-status" role="status">{{ trans('public.pages.contact.form_unavailable') }}</p>

    <form class="contact-form" aria-describedby="contact-form-status">
        <fieldset disabled>
            <legend>{{ trans('public.pages.contact.form_legend') }}</legend>
            <div class="contact-field">
                <label for="contact-name">{{ trans('public.pages.contact.name_label') }}</label>
                <input id="contact-name" name="name" type="text" autocomplete="name" required>
            </div>
            <div class="contact-field">
                <label for="contact-email">{{ trans('public.pages.contact.email_label') }}</label>
                <input id="contact-email" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="contact-field">
                <label for="contact-message">{{ trans('public.pages.contact.message_label') }}</label>
                <textarea id="contact-message" name="message" rows="6" required></textarea>
            </div>
            <button class="contact-submit" type="submit" disabled>
                {{ trans('public.pages.contact.submit') }}
            </button>
        </fieldset>
    </form>
</section>

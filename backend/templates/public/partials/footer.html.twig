<footer class="site-footer">
    <div class="container site-footer__inner">
        <div class="site-footer__brand">
            <a class="brand" href="/{{ locale }}/" aria-label="{{ trans('public.home_link') }}">
                <span class="brand__mark" aria-hidden="true"></span>
                <span class="brand__name">Skimr</span>
            </a>
            <p class="site-footer__tagline">{{ trans('public.home.description') }}</p>
        </div>
        {% if page_urls is defined %}
            <nav class="site-footer__nav" aria-label="{{ trans('public.footer_navigation') }}">
                <ul>
                    {% for page in ['features', 'how_it_works', 'about', 'contact'] %}
                        <li><a href="{{ page_urls[page] }}">{{ trans('public.navigation.' ~ page) }}</a></li>
                    {% endfor %}
                </ul>
                <ul>
                    {% for page in ['privacy', 'terms', 'cookies'] %}
                        <li><a href="{{ page_urls[page] }}">{{ trans('public.navigation.' ~ page) }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    </div>
    <div class="container site-footer__bottom">
        <p>{{ trans('public.footer.copyright', {year: 'now'|date('Y')}) }}</p>
        {% include 'partials/language-switcher.html.twig' with {variant: 'full'} %}
    </div>
</footer>

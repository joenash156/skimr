<section class="contact-page" aria-labelledby="contact-title">
    <h1 id="contact-title">{{ trans('public.pages.contact.heading') }}</h1>
    <p>{{ trans('public.pages.contact.intro') }}</p>
    <p id="contact-form-status" role="status" aria-live="polite">
        {{ turnstile_site_key ? trans('public.pages.contact.form_ready') : trans('public.pages.contact.form_unavailable') }}
    </p>

    <form class="contact-form"
          method="post"
          data-contact-form
          data-endpoint="/api/v1/contact"
          data-locale="{{ locale }}"
          data-sending-message="{{ trans('public.pages.contact.sending') }}"
          data-network-error="{{ trans('public.pages.contact.network_error') }}"
          data-turnstile-required="{{ trans('public.pages.contact.turnstile_required') }}"
          aria-describedby="contact-form-status">
        <fieldset data-contact-fields disabled>
            <legend>{{ trans('public.pages.contact.form_legend') }}</legend>
            <div class="contact-field">
                <label for="contact-name">{{ trans('public.pages.contact.name_label') }}</label>
                <input id="contact-name" name="name" type="text" maxlength="100" autocomplete="name"
                       aria-describedby="contact-name-error" required>
                <p id="contact-name-error" class="contact-error" hidden></p>
            </div>
            <div class="contact-field">
                <label for="contact-email">{{ trans('public.pages.contact.email_label') }}</label>
                <input id="contact-email" name="email" type="email" maxlength="254" autocomplete="email"
                       aria-describedby="contact-email-error" required>
                <p id="contact-email-error" class="contact-error" hidden></p>
            </div>
            <div class="contact-field">
                <label for="contact-message">{{ trans('public.pages.contact.message_label') }}</label>
                <textarea id="contact-message" name="message" minlength="10" maxlength="5000" rows="6"
                          aria-describedby="contact-message-error" required></textarea>
                <p id="contact-message-error" class="contact-error" hidden></p>
            </div>
            <button class="contact-submit" type="submit">
                {{ trans('public.pages.contact.submit') }}
            </button>
        </fieldset>
        {% if turnstile_site_key %}
            <div class="cf-turnstile" data-sitekey="{{ turnstile_site_key }}" data-action="contact"></div>
        {% endif %}
    </form>

    <noscript>{{ trans('public.pages.contact.javascript_required') }}</noscript>
    {% if turnstile_site_key %}
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        <script src="/assets/contact.js" defer></script>
    {% endif %}
</section>

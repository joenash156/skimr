<section aria-labelledby="page-title">
    <header class="page-header">
        <h1 id="page-title">{{ trans('public.pages.features.heading') }}</h1>
        <p class="lead">{{ trans('public.pages.features.intro') }}</p>
    </header>
    <ul class="grid grid--3 feature-list">
        {% for feature in features %}
            <li>
                <article id="feature-{{ feature.id|lower }}" class="card card--plain feature">
                    <span class="badge badge--{{ feature.tier }}">{{ trans('public.pages.features.tiers.' ~ feature.tier) }}</span>
                    <h2 class="card__title">{{ trans('public.pages.features.items.' ~ feature.key ~ '.title') }}</h2>
                    <p>{{ trans('public.pages.features.items.' ~ feature.key ~ '.description') }}</p>
                </article>
            </li>
        {% endfor %}
    </ul>
    <p class="note">{{ trans('public.pages.features.tier_note') }}</p>
</section>

# Copy this file to ai-service/.env (git-ignored) and fill in the real values.
# Real keys come privately from P1. Never commit them or paste them into chats.
# On Render, set these in the service's Environment settings instead.
# Real environment variables override values in ai-service/.env.

# Shared HMAC secret. Must equal AI_SERVICE_SECRET in the PHP app's root .env.
# At least 32 characters; the service refuses to start with this placeholder.
AI_SERVICE_SECRET=change-me-shared-hmac-secret

GEMINI_API_KEY=
GROQ_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Comma-separated; tried in this order (spec 6.5).
LLM_PROVIDER_ORDER=gemini,groq

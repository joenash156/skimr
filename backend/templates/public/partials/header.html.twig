{% import 'macros/icons.html.twig' as ui %}
{% set nav = {features: 'grid', how_it_works: 'workflow', about: 'info', contact: 'mail'} %}
<header class="site-header" x-data="mobileMenu" x-on:keydown.escape.window="close">
    <div class="wrap site-header__inner">
        {% include 'partials/brand.html.twig' %}

        {% if page_urls is defined %}
            <nav class="site-nav" aria-label="{{ trans('public.main_navigation') }}">
                {% for page, icon in nav %}
                    <a class="site-nav__link anim-host" href="{{ page_urls[page] }}"
                       {% if page_key is defined and page_key == page %}aria-current="page"{% endif %}>
                        {{ ui.icon(icon, 'icon icon--draw') }}
                        <span>{{ trans('public.navigation.' ~ page) }}</span>
                    </a>
                {% endfor %}
            </nav>
        {% endif %}

        <div class="site-header__actions">
            <div class="desktop-only site-header__tools">
                {% include 'partials/languages.html.twig' with {variant: 'menu', uid: 'h'} %}
                {% include 'partials/theme-switch.html.twig' with {variant: 'compact', uid: 'h'} %}
            </div>
            <span class="site-header__divider desktop-only" aria-hidden="true"></span>
            <a class="btn btn--ghost btn--sm btn--pill desktop-only" href="/app/login">{{ trans('public.login') }}</a>
            <a class="btn btn--primary btn--sm btn--pill anim-host hide-xs" href="/app/register">
                {{ trans('public.get_started') }} {{ ui.icon('arrow-right', 'icon btn__arrow') }}
            </a>
            {# The icon follows aria-expanded in CSS, so no extra Alpine expressions are needed. #}
            <button class="icon-btn menu-toggle mobile-only" type="button" x-on:click="toggle"
                    x-bind:aria-expanded="open" aria-expanded="false" aria-controls="mobile-menu"
                    aria-label="{{ trans('public.menu') }}">
                {{ ui.icon('menu', 'icon menu-toggle__open') }}
                {{ ui.icon('close', 'icon menu-toggle__close') }}
            </button>
        </div>
    </div>
    {% include 'partials/mobile-menu.html.twig' %}
</header>

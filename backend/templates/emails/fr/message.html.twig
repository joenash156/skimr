{% extends "fr/layout.html.twig" %}

{% block content %}
    {% if template == 'verify_email' %}
        <h1 style="font-size:24px;line-height:1.3;">Confirmez votre adresse e-mail</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Confirmez votre adresse e-mail pour activer votre compte Skimr. Ce lien expire dans {{ expires_hours }} heures.</p>
        <p><a href="{{ link }}" style="display:inline-block;padding:12px 20px;background-color:#087f8c;color:#ffffff;text-decoration:none;border-radius:4px;">Confirmer mon e-mail</a></p>
    {% elseif template == 'reset_password' %}
        <h1 style="font-size:24px;line-height:1.3;">Réinitialisez votre mot de passe</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Nous avons reçu une demande de réinitialisation de votre mot de passe Skimr. Ce lien expire dans {{ expires_minutes }} minutes.</p>
        <p><a href="{{ link }}" style="display:inline-block;padding:12px 20px;background-color:#087f8c;color:#ffffff;text-decoration:none;border-radius:4px;">Réinitialiser mon mot de passe</a></p>
        <p>Si vous n’êtes pas à l’origine de cette demande, ignorez ce message.</p>
    {% elseif template == 'new_sign_in' %}
        <h1 style="font-size:24px;line-height:1.3;">Nouvelle connexion à votre compte</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Un nouvel appareil s’est connecté à votre compte Skimr le {{ at }}.</p>
        <p>Adresse IP : {{ ip }}<br>Appareil : {{ user_agent }}</p>
        <p>Si vous n’êtes pas à l’origine de cette connexion, réinitialisez votre mot de passe et vérifiez la sécurité de votre compte.</p>
    {% elseif template == 'password_changed' %}
        <h1 style="font-size:24px;line-height:1.3;">Votre mot de passe a été modifié</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Votre mot de passe Skimr a été modifié le {{ at }}. Si vous n’êtes pas à l’origine de cette modification, sécurisez immédiatement votre compte.</p>
    {% elseif template == 'suspicious_activity' %}
        <h1 style="font-size:24px;line-height:1.3;">Alerte de sécurité</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Nous avons détecté une activité inhabituelle sur votre compte Skimr le {{ at }} et avons fermé toutes vos sessions. Connectez-vous et vérifiez la sécurité de votre compte.</p>
    {% elseif template == 'email_change_requested' %}
        <h1 style="font-size:24px;line-height:1.3;">Demande de changement d’adresse e-mail</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>Une demande effectuée le {{ at }} vise à remplacer l’adresse e-mail de votre compte Skimr par {{ new_email }}. Le changement ne sera appliqué qu’après confirmation de cette adresse.</p>
        <p>Si vous n’êtes pas à l’origine de cette demande, sécurisez immédiatement votre compte.</p>
    {% elseif template == 'email_changed' %}
        <h1 style="font-size:24px;line-height:1.3;">Votre adresse e-mail a été modifiée</h1>
        <p>Bonjour {{ first_name }},</p>
        <p>L’adresse e-mail de votre compte Skimr a été remplacée par {{ new_email }} le {{ at }}. Si vous n’êtes pas à l’origine de ce changement, sécurisez immédiatement votre compte.</p>
    {% elseif template == 'contact_message' %}
        <h1 style="font-size:24px;line-height:1.3;">Nouveau message de contact</h1>
        <p><strong>De :</strong> {{ name }} ({{ email }})<br><strong>Reçu le :</strong> {{ at }}</p>
        <p>{{ message|e|nl2br }}</p>
    {% endif %}
{% endblock %}


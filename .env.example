# Skimr environment template (spec 17.4).
# Copy to .env (git-ignored) and fill in real values. NEVER commit .env.
# Real keys are shared only through a private channel (password manager or pinned DM),
# never in the repo, screenshots or AI-assistant chats.
#
# Local: put .env in the repository root. Staging: put it in backend/ on the server.

APP_ENV=local            # local | staging | production
APP_DEBUG=true           # ignored (always off) unless APP_ENV is local
APP_URL=http://localhost:8080
APP_NAME="Skimr"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skimr_dev
DB_USER=root
DB_PASS=

# 64+ random bytes each, different from each other. Generate with:
#   php -r "echo bin2hex(random_bytes(64)), PHP_EOL;"
JWT_ACCESS_SECRET=change-me-64-random-bytes
JWT_REFRESH_SECRET=change-me-different-64-random-bytes

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Cloudflare's public test keys: they always pass. Real keys only on staging/production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

RESEND_API_KEY=
MAIL_FROM="Skimr <no-reply@mail.foliony.app>"
MAIL_REPLY_TO=

CLOUDINARY_URL=

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=change-me-shared-hmac-secret

LOG_LEVEL=debug

# Staging only, and only while deploying: enables the browser migration page at
# /_system/migrate (deploy/README.md). 32+ random characters. Remove it afterwards.
# MIGRATION_TOKEN=

# --- ai-service/.env only (P3) ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# LLM_PROVIDER_ORDER=gemini,groq

{
    "name": "skimr/backend",
    "description": "Skimr PHP application: public site, JSON API and React host",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "cloudinary/cloudinary_php": "^3.3",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "firebase/php-jwt": "^7.2",
        "guzzlehttp/guzzle": "^7.9",
        "league/commonmark": "^2.5",
        "league/oauth2-google": "^4.0",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "phpoffice/phpword": "^1.3",
        "ramsey/uuid": "^4.7",
        "resend/resend-php": "^1.18",
        "respect/validation": "^2.3",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "symfony/console": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 -t public public/index.php"
        ],
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "migrate": "doctrine-migrations migrate --no-interaction",
        "migrate:prev": "doctrine-migrations migrate prev --no-interaction",
        "contract": "php bin/check-contract.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

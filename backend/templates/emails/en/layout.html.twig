<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{ app_name }}</title>
</head>
{# Email-safe layout: tables and inline styles only. Black and white, teal as a small accent (spec 14). #}
<body style="margin:0;padding:32px 12px;background-color:#f6f7f7;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0a0a0a;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
        <td align="center">
            <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;">
                <tr>
                    <td style="padding:0 4px 20px;">
                        <a href="{{ app_url }}" style="text-decoration:none;">
                            <img src="{{ app_url }}/assets/brand/logo-light.png" width="130" height="32" alt="{{ app_name }}" style="display:block;border:0;width:130px;height:32px;">
                        </a>
                    </td>
                </tr>
                <tr>
                    <td style="background-color:#ffffff;border:1px solid #e2e6e6;border-radius:12px;padding:36px 36px 32px;font-size:16px;line-height:1.6;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:20px 4px 0;color:#525a5a;font-size:13px;line-height:1.6;">
                        {% if template == 'contact_message' %}
                            This message was submitted through the Skimr contact form.
                        {% else %}
                            You received this email because it concerns your Skimr account.
                            {% if optional %}
                                <br><a href="{{ notification_settings_url }}" style="color:#0a0a0a;text-decoration:underline;">Notification settings</a>
                            {% endif %}
                        {% endif %}
                        <br><span style="color:#7a8282;">&copy; {{ 'now'|date('Y') }} {{ app_name }}</span>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>

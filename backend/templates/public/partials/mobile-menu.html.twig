<nav id="mobile-menu" class="mobile-menu" x-show="open" x-cloak
     aria-label="{{ trans('public.mobile_navigation') }}">
    <a href="/{{ locale }}/#main">{{ trans('public.navigation.home') }}</a>
    {% if locale == 'en' %}
        <a href="/en/features">{{ trans('public.navigation.features') }}</a>
        <a href="/en/how-it-works">{{ trans('public.navigation.how_it_works') }}</a>
        <a href="/en/about">{{ trans('public.navigation.about') }}</a>
    {% endif %}
    <a href="/app/login">{{ trans('public.login') }}</a>
    <a href="/app/register">{{ trans('public.signup') }}</a>
    <div class="language-switcher" aria-label="{{ trans('public.language') }}">
        <a href="/en/" lang="en" hreflang="en">English</a>
        <a href="/fr/" lang="fr" hreflang="fr">Français</a>
        <a href="/es/" lang="es" hreflang="es">Español</a>
    </div>
    <div class="theme-toggle" x-data="themeToggle">
        <button type="button" x-on:click="toggle" aria-label="{{ trans('public.theme.toggle') }}">
            {{ trans('public.theme.toggle') }}
        </button>
    </div>
</nav>

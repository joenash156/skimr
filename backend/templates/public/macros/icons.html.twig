{#
 # Inline line icons (24 x 24, 1.75 stroke, currentColor), drawn to match lucide,
 # the icon set the dashboard uses (spec 8). Decorative: the surrounding link or
 # button carries the accessible name.
 #
 # Every shape has pathLength="1", so CSS can "draw" the icon on hover
 # (.icon--draw inside an .anim-host; see site.css "Animated icons").
 #}
{% macro icon(name, class = 'icon') %}

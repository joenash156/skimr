{% extends 'base.html.twig' %}

{% block content %}
    <section class="hero" aria-labelledby="home-title">
        {% if locale == 'en' %}
            <p>{{ trans('public.home.eyebrow') }}</p>
        {% endif %}
        <h1 id="home-title">{{ trans('public.home.heading') }}</h1>
        {% if locale == 'en' %}
            <p>{{ trans('public.home.intro') }}</p>
            <p>
                <a href="/app/register">{{ trans('public.home.primary_cta') }}</a>
                <a href="/en/how-it-works">{{ trans('public.home.secondary_cta') }}</a>
            </p>
        {% endif %}
    </section>

    {% if locale == 'en' %}
        <section aria-labelledby="home-how-title">
            <h2 id="home-how-title">{{ trans('public.home.how_it_works.heading') }}</h2>
            <ol>
                {% for step in 1..3 %}
                    <li>
                        <h3>{{ trans('public.home.how_it_works.steps.' ~ step ~ '.title') }}</h3>
                        <p>{{ trans('public.home.how_it_works.steps.' ~ step ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ol>
        </section>

        <section aria-labelledby="home-sources-title">
            <h2 id="home-sources-title">{{ trans('public.home.sources.heading') }}</h2>
            <p>{{ trans('public.home.sources.intro') }}</p>
            <ul>
                {% for source in ['pdf', 'images', 'links', 'text', 'discovery'] %}
                    <li>
                        <h3>{{ trans('public.home.sources.items.' ~ source ~ '.title') }}</h3>
                        <p>{{ trans('public.home.sources.items.' ~ source ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ul>
        </section>

        <section aria-labelledby="home-features-title">
            <h2 id="home-features-title">{{ trans('public.home.highlights.heading') }}</h2>
            <ul>
                {% for feature in ['search', 'themes', 'methods', 'synthesis', 'citations', 'gaps'] %}
                    <li>
                        <h3>{{ trans('public.home.highlights.items.' ~ feature ~ '.title') }}</h3>
                        <p>{{ trans('public.home.highlights.items.' ~ feature ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ul>
            <a href="/en/features">{{ trans('public.home.highlights.link') }}</a>
        </section>

        <section aria-labelledby="home-evidence-title">
            <h2 id="home-evidence-title">{{ trans('public.home.evidence.heading') }}</h2>
            <p>{{ trans('public.home.evidence.intro') }}</p>
            <div class="evidence-types">
                <article>
                    <h3>{{ trans('public.home.evidence.finding.title') }}</h3>
                    <p>{{ trans('public.home.evidence.finding.description') }}</p>
                </article>
                <article>
                    <h3>{{ trans('public.home.evidence.interpretation.title') }}</h3>
                    <p>{{ trans('public.home.evidence.interpretation.description') }}</p>
                </article>
            </div>
        </section>

        <section aria-labelledby="home-faq-title">
            <h2 id="home-faq-title">{{ trans('public.home.faq.heading') }}</h2>
            {% for question in ['evidence', 'sources', 'privacy', 'languages'] %}
                <details>
                    <summary>{{ trans('public.home.faq.items.' ~ question ~ '.question') }}</summary>
                    <p>{{ trans('public.home.faq.items.' ~ question ~ '.answer') }}</p>
                </details>
            {% endfor %}
        </section>

        <section aria-labelledby="home-cta-title">
            <h2 id="home-cta-title">{{ trans('public.home.cta.heading') }}</h2>
            <p>{{ trans('public.home.cta.description') }}</p>
            <a href="/app/register">{{ trans('public.home.primary_cta') }}</a>
        </section>
    {% endif %}
{% endblock %}

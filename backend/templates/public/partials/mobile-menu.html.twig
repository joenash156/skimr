<nav id="mobile-menu" class="mobile-menu" x-show="open" x-cloak
     aria-label="{{ trans('public.mobile_navigation') }}">
    <a href="/{{ locale }}/#main">{{ trans('public.navigation.home') }}</a>
    {% if page_urls is defined %}
        {% for page in ['features', 'how_it_works', 'about'] %}
            <a href="{{ page_urls[page] }}">{{ trans('public.navigation.' ~ page) }}</a>
        {% endfor %}
    {% endif %}
    <a href="/app/login">{{ trans('public.login') }}</a>
    <a href="/app/register">{{ trans('public.signup') }}</a>
    {% include 'partials/language-switcher.html.twig' %}
    <div class="theme-toggle" x-data="themeToggle">
        <button type="button" x-on:click="toggle" aria-label="{{ trans('public.theme.toggle') }}">
            {{ trans('public.theme.toggle') }}
        </button>
    </div>
</nav>

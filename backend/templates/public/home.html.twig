{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as ui %}

{% block content %}
    <section class="hero" aria-labelledby="home-title">
        <div class="container hero__inner">
            <div class="hero__copy">
                <p class="eyebrow">{{ trans('public.home.eyebrow') }}</p>
                <h1 id="home-title" class="hero__title">{{ trans('public.home.heading') }}</h1>
                <p class="lead">{{ trans('public.home.intro') }}</p>
                <div class="actions">
                    <a class="btn btn--primary btn--lg" href="/app/register">
                        {{ trans('public.home.primary_cta') }} {{ ui.icon('arrow-right') }}
                    </a>
                    <a class="btn btn--secondary btn--lg" href="{{ page_urls.how_it_works }}">
                        {{ trans('public.home.secondary_cta') }}
                    </a>
                </div>
            </div>

            {# An illustration of the evidence rule (spec 2), built from text so it translates. #}
            <figure class="demo" aria-labelledby="demo-caption">
                <figcaption id="demo-caption" class="demo__bar">
                    <span class="demo__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span>{{ trans('public.home.demo.caption') }}</span>
                </figcaption>
                <div class="demo__body">
                    <p class="demo__theme">{{ trans('public.home.demo.theme') }}</p>
                    {% for finding in ['finding_1', 'finding_2'] %}
                        <div class="finding">
                            <p class="finding__label">{{ ui.icon('quote') }} {{ trans('public.home.evidence.finding.title') }}</p>
                            <blockquote class="finding__quote">{{ trans('public.home.demo.' ~ finding ~ '.quote') }}</blockquote>
                            <span class="source-chip">{{ ui.icon('file') }} {{ trans('public.home.demo.' ~ finding ~ '.source') }}</span>
                        </div>
                    {% endfor %}
                    <div class="interpretation">
                        <p class="interpretation__label">{{ ui.icon('sparkle') }} {{ trans('public.home.evidence.interpretation.title') }}</p>
                        <p>{{ trans('public.home.demo.interpretation.text') }}</p>
                        <p class="interpretation__support">{{ ui.icon('check') }} {{ trans('public.home.demo.interpretation.support') }}</p>
                    </div>
                </div>
            </figure>
        </div>
    </section>

    <section class="section" aria-labelledby="home-how-title">
        <div class="container">
            <h2 id="home-how-title" class="section__title">{{ trans('public.home.how_it_works.heading') }}</h2>
            <ol class="steps">
                {% for step in 1..3 %}
                    <li class="step">
                        <span class="step__number" aria-hidden="true">{{ step }}</span>
                        <h3 class="step__title">{{ trans('public.home.how_it_works.steps.' ~ step ~ '.title') }}</h3>
                        <p>{{ trans('public.home.how_it_works.steps.' ~ step ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    <section class="section section--surface" aria-labelledby="home-sources-title">
        <div class="container">
            <div class="section__head">
                <h2 id="home-sources-title" class="section__title">{{ trans('public.home.sources.heading') }}</h2>
                <p class="section__intro">{{ trans('public.home.sources.intro') }}</p>
            </div>
            {% set source_icons = {pdf: 'file', images: 'image', links: 'link', text: 'clipboard', discovery: 'search'} %}
            <ul class="grid grid--5">
                {% for source, icon in source_icons %}
                    <li class="card">
                        <span class="card__icon">{{ ui.icon(icon) }}</span>
                        <h3 class="card__title">{{ trans('public.home.sources.items.' ~ source ~ '.title') }}</h3>
                        <p>{{ trans('public.home.sources.items.' ~ source ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section class="section" aria-labelledby="home-features-title">
        <div class="container">
            <div class="section__head section__head--row">
                <h2 id="home-features-title" class="section__title">{{ trans('public.home.highlights.heading') }}</h2>
                <a class="text-link" href="{{ page_urls.features }}">
                    {{ trans('public.home.highlights.link') }} {{ ui.icon('arrow-right') }}
                </a>
            </div>
            {% set feature_icons = {search: 'search', themes: 'layers', methods: 'columns', synthesis: 'pen', citations: 'network', gaps: 'compass'} %}
            <ul class="grid grid--3">
                {% for feature, icon in feature_icons %}
                    <li class="card card--plain">
                        <span class="card__icon">{{ ui.icon(icon) }}</span>
                        <h3 class="card__title">{{ trans('public.home.highlights.items.' ~ feature ~ '.title') }}</h3>
                        <p>{{ trans('public.home.highlights.items.' ~ feature ~ '.description') }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section class="section section--surface" aria-labelledby="home-evidence-title">
        <div class="container">
            <div class="section__head">
                <h2 id="home-evidence-title" class="section__title">{{ trans('public.home.evidence.heading') }}</h2>
                <p class="section__intro">{{ trans('public.home.evidence.intro') }}</p>
            </div>
            <div class="grid grid--2">
                <article class="finding finding--card">
                    <p class="finding__label">{{ ui.icon('quote') }} {{ trans('public.home.evidence.finding.title') }}</p>
                    <p>{{ trans('public.home.evidence.finding.description') }}</p>
                </article>
                <article class="interpretation">
                    <p class="interpretation__label">{{ ui.icon('sparkle') }} {{ trans('public.home.evidence.interpretation.title') }}</p>
                    <p>{{ trans('public.home.evidence.interpretation.description') }}</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="home-faq-title">
        <div class="container container--narrow">
            <h2 id="home-faq-title" class="section__title">{{ trans('public.home.faq.heading') }}</h2>
            <div class="faq">
                {% for question in ['evidence', 'sources', 'privacy', 'languages'] %}
                    <details class="faq__item">
                        <summary>
                            {{ trans('public.home.faq.items.' ~ question ~ '.question') }}
                            {{ ui.icon('chevron-down', 'icon faq__chevron') }}
                        </summary>
                        <p>{{ trans('public.home.faq.items.' ~ question ~ '.answer') }}</p>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section section--tight" aria-labelledby="home-cta-title">
        <div class="container">
            <div class="cta">
                <div>
                    <h2 id="home-cta-title" class="cta__title">{{ trans('public.home.cta.heading') }}</h2>
                    <p>{{ trans('public.home.cta.description') }}</p>
                </div>
                <a class="btn btn--primary btn--lg" href="/app/register">
                    {{ trans('public.home.primary_cta') }} {{ ui.icon('arrow-right') }}
                </a>
            </div>
        </div>
    </section>
{% endblock %}
